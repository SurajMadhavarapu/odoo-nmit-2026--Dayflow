<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Demo Data
    =================
    Provides deterministic seed data for development and hackathon demo.

    Users created:
      - hr.admin@dayflow.com    → HR/Admin role
      - alice@dayflow.com       → Employee
      - bob@dayflow.com         → Employee
      - carol@dayflow.com       → Employee

    Covers: employee profiles, attendance (present/half-day/leave/absent),
            leave requests (pending/approved/rejected), payroll records.
-->
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             RES USERS — Demo users
             ============================================================ -->

        <record id="user_hr_admin" model="res.users">
            <field name="name">HR Admin</field>
            <field name="login">hr.admin@dayflow.com</field>
            <field name="email">hr.admin@dayflow.com</field>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('dayflow.group_dayflow_hr_admin'))
            ]"/>
        </record>

        <record id="user_alice" model="res.users">
            <field name="name">Alice Fernandes</field>
            <field name="login">alice@dayflow.com</field>
            <field name="email">alice@dayflow.com</field>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('dayflow.group_dayflow_employee'))
            ]"/>
        </record>

        <record id="user_bob" model="res.users">
            <field name="name">Bob Sharma</field>
            <field name="login">bob@dayflow.com</field>
            <field name="email">bob@dayflow.com</field>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('dayflow.group_dayflow_employee'))
            ]"/>
        </record>

        <record id="user_carol" model="res.users">
            <field name="name">Carol Nair</field>
            <field name="login">carol@dayflow.com</field>
            <field name="email">carol@dayflow.com</field>
            <field name="groups_id" eval="[
                (4, ref('base.group_user')),
                (4, ref('dayflow.group_dayflow_employee'))
            ]"/>
        </record>

        <!-- ============================================================
             HR.EMPLOYEE — Demo employees
             ============================================================ -->

        <record id="employee_hr_admin" model="hr.employee">
            <field name="name">HR Admin</field>
            <field name="work_email">hr.admin@dayflow.com</field>
            <field name="user_id" ref="user_hr_admin"/>
            <field name="job_title">HR Officer</field>
            <field name="dayflow_employee_id">DF-000</field>
            <field name="employment_type">full_time</field>
            <field name="date_of_joining">2023-01-01</field>
            <field name="phone_number">+91 98000 00000</field>
            <field name="city">Bangalore</field>
            <field name="country_name">India</field>
        </record>

        <record id="employee_alice" model="hr.employee">
            <field name="name">Alice Fernandes</field>
            <field name="work_email">alice@dayflow.com</field>
            <field name="user_id" ref="user_alice"/>
            <field name="job_title">Software Engineer</field>
            <field name="dayflow_employee_id">DF-001</field>
            <field name="employment_type">full_time</field>
            <field name="date_of_joining">2024-03-15</field>
            <field name="phone_number">+91 98111 11111</field>
            <field name="address_line1">12, MG Road</field>
            <field name="city">Bangalore</field>
            <field name="state_region">Karnataka</field>
            <field name="postal_code">560001</field>
            <field name="country_name">India</field>
        </record>

        <record id="employee_bob" model="hr.employee">
            <field name="name">Bob Sharma</field>
            <field name="work_email">bob@dayflow.com</field>
            <field name="user_id" ref="user_bob"/>
            <field name="job_title">Product Manager</field>
            <field name="dayflow_employee_id">DF-002</field>
            <field name="employment_type">full_time</field>
            <field name="date_of_joining">2023-07-01</field>
            <field name="phone_number">+91 98222 22222</field>
            <field name="address_line1">45, Indiranagar</field>
            <field name="city">Bangalore</field>
            <field name="state_region">Karnataka</field>
            <field name="postal_code">560038</field>
            <field name="country_name">India</field>
        </record>

        <record id="employee_carol" model="hr.employee">
            <field name="name">Carol Nair</field>
            <field name="work_email">carol@dayflow.com</field>
            <field name="user_id" ref="user_carol"/>
            <field name="job_title">UX Designer</field>
            <field name="dayflow_employee_id">DF-003</field>
            <field name="employment_type">full_time</field>
            <field name="date_of_joining">2024-01-10</field>
            <field name="phone_number">+91 98333 33333</field>
            <field name="address_line1">78, Koramangala</field>
            <field name="city">Bangalore</field>
            <field name="state_region">Karnataka</field>
            <field name="postal_code">560034</field>
            <field name="country_name">India</field>
        </record>

        <!-- ============================================================
             DAYFLOW.ATTENDANCE — Sample records
             ============================================================ -->

        <!-- Alice: Present today -->
        <record id="attendance_alice_today" model="dayflow.attendance">
            <field name="employee_id" ref="employee_alice"/>
            <field name="date">2026-08-22</field>
            <field name="check_in">2026-08-22 09:00:00</field>
            <field name="check_out">2026-08-22 18:00:00</field>
            <field name="status">present</field>
        </record>

        <!-- Alice: Half-day yesterday -->
        <record id="attendance_alice_halfday" model="dayflow.attendance">
            <field name="employee_id" ref="employee_alice"/>
            <field name="date">2026-08-21</field>
            <field name="check_in">2026-08-21 09:00:00</field>
            <field name="check_out">2026-08-21 13:00:00</field>
            <field name="status">half_day</field>
        </record>

        <!-- Bob: Present today -->
        <record id="attendance_bob_today" model="dayflow.attendance">
            <field name="employee_id" ref="employee_bob"/>
            <field name="date">2026-08-22</field>
            <field name="check_in">2026-08-22 09:15:00</field>
            <field name="check_out">2026-08-22 18:30:00</field>
            <field name="status">present</field>
        </record>

        <!-- Bob: Absent day before -->
        <record id="attendance_bob_absent" model="dayflow.attendance">
            <field name="employee_id" ref="employee_bob"/>
            <field name="date">2026-08-20</field>
            <field name="status">absent</field>
        </record>

        <!-- Carol: On Leave -->
        <record id="attendance_carol_leave" model="dayflow.attendance">
            <field name="employee_id" ref="employee_carol"/>
            <field name="date">2026-08-22</field>
            <field name="status">leave</field>
            <field name="notes">Annual paid leave</field>
        </record>

        <!-- ============================================================
             DAYFLOW.LEAVE.REQUEST — Sample records
             ============================================================ -->

        <!-- Carol: Approved paid leave (covers today) -->
        <record id="leave_carol_approved" model="dayflow.leave.request">
            <field name="employee_id" ref="employee_carol"/>
            <field name="leave_type">paid</field>
            <field name="date_from">2026-08-22</field>
            <field name="date_to">2026-08-24</field>
            <field name="remarks">Annual vacation</field>
            <field name="status">approved</field>
            <field name="approved_by" ref="user_hr_admin"/>
            <field name="action_date">2026-08-19 10:00:00</field>
            <field name="hr_comment">Approved. Enjoy your break!</field>
        </record>

        <!-- Alice: Pending sick leave request -->
        <record id="leave_alice_pending" model="dayflow.leave.request">
            <field name="employee_id" ref="employee_alice"/>
            <field name="leave_type">sick</field>
            <field name="date_from">2026-08-25</field>
            <field name="date_to">2026-08-26</field>
            <field name="remarks">Feeling unwell, doctor appointment on 25th.</field>
            <field name="status">pending</field>
        </record>

        <!-- Bob: Rejected unpaid leave -->
        <record id="leave_bob_rejected" model="dayflow.leave.request">
            <field name="employee_id" ref="employee_bob"/>
            <field name="leave_type">unpaid</field>
            <field name="date_from">2026-08-18</field>
            <field name="date_to">2026-08-19</field>
            <field name="remarks">Personal work</field>
            <field name="status">rejected</field>
            <field name="approved_by" ref="user_hr_admin"/>
            <field name="action_date">2026-08-17 14:00:00</field>
            <field name="hr_comment">Critical sprint period, cannot approve at this time.</field>
        </record>

        <!-- ============================================================
             DAYFLOW.PAYROLL — Sample salary records
             ============================================================ -->

        <record id="payroll_alice" model="dayflow.payroll">
            <field name="employee_id" ref="employee_alice"/>
            <field name="effective_date">2026-04-01</field>
            <field name="basic_salary">65000.00</field>
            <field name="house_rent_allowance">20000.00</field>
            <field name="transport_allowance">3000.00</field>
            <field name="other_allowances">2000.00</field>
            <field name="tax_deduction">8000.00</field>
            <field name="provident_fund">7800.00</field>
            <field name="other_deductions">0.00</field>
            <field name="notes">FY 2026-27 salary structure</field>
        </record>

        <record id="payroll_bob" model="dayflow.payroll">
            <field name="employee_id" ref="employee_bob"/>
            <field name="effective_date">2026-04-01</field>
            <field name="basic_salary">80000.00</field>
            <field name="house_rent_allowance">25000.00</field>
            <field name="transport_allowance">4000.00</field>
            <field name="other_allowances">3000.00</field>
            <field name="tax_deduction">12000.00</field>
            <field name="provident_fund">9600.00</field>
            <field name="other_deductions">0.00</field>
            <field name="notes">FY 2026-27 salary structure</field>
        </record>

        <record id="payroll_carol" model="dayflow.payroll">
            <field name="employee_id" ref="employee_carol"/>
            <field name="effective_date">2026-04-01</field>
            <field name="basic_salary">70000.00</field>
            <field name="house_rent_allowance">22000.00</field>
            <field name="transport_allowance">3500.00</field>
            <field name="other_allowances">2500.00</field>
            <field name="tax_deduction">10000.00</field>
            <field name="provident_fund">8400.00</field>
            <field name="other_deductions">0.00</field>
            <field name="notes">FY 2026-27 salary structure</field>
        </record>

    </data>
</odoo>
