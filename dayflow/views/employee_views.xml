<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Employee Views
    Owner: Mani (HR Core)
    Extends the standard hr.employee form with a Dayflow tab.
    Harshith: extend/replace the Dayflow tab for the full dashboard UI.
-->
<odoo>
    <data>

        <!-- ============================================================
             EXTEND hr.employee FORM — add Dayflow tab
        ============================================================ -->
        <record id="view_dayflow_employee_form" model="ir.ui.view">
            <field name="name">dayflow.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Dayflow" name="dayflow_tab">

                        <group string="Dayflow Identity">
                            <field name="df_employee_id"/>
                            <field name="df_employment_type"/>
                            <field name="df_joining_date"/>
                            <field name="df_role"
                                   groups="dayflow.group_dayflow_hr_admin"/>
                        </group>

                        <group string="Personal Contact" col="2">
                            <field name="df_phone"/>
                            <field name="df_address" widget="text"/>
                            <field name="df_emergency_contact"/>
                            <field name="df_emergency_phone"/>
                        </group>

                        <group string="Demographics"
                               groups="dayflow.group_dayflow_hr_admin">
                            <field name="df_date_of_birth"/>
                            <field name="df_gender"/>
                        </group>

                        <separator string="Attendance Summary (read-only)"/>
                        <field name="df_attendance_ids" readonly="1">
                            <tree>
                                <field name="date"/>
                                <field name="check_in"/>
                                <field name="check_out"/>
                                <field name="worked_hours" widget="float_time"/>
                                <field name="status"
                                       decoration-success="status == 'present'"
                                       decoration-warning="status == 'half_day'"
                                       decoration-danger="status == 'absent'"
                                       decoration-info="status == 'leave'"/>
                            </tree>
                        </field>

                        <separator string="Leave Requests (read-only)"/>
                        <field name="df_leave_ids" readonly="1">
                            <tree>
                                <field name="leave_type"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="number_of_days"/>
                                <field name="state"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-warning="state in ('draft','pending')"/>
                            </tree>
                        </field>

                    </page>
                </xpath>
            </field>
        </record>

        <!-- ============================================================
             EMPLOYEE LIST / KANBAN (HR Admin)
        ============================================================ -->
        <record id="action_dayflow_employees" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No employees yet. Create the first one!
                </p>
            </field>
        </record>

    </data>
</odoo>
