<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             AUDIT LOG — List View (HR/Admin read-only)
             ============================================================ -->
        <record id="view_dayflow_audit_log_list" model="ir.ui.view">
            <field name="name">dayflow.audit.log.list</field>
            <field name="model">dayflow.audit.log</field>
            <field name="arch" type="xml">
                <tree string="Audit Log" create="false" edit="false" delete="false">
                    <field name="timestamp"/>
                    <field name="user_name"/>
                    <field name="action"/>
                    <field name="model_name"/>
                    <field name="record_name"/>
                    <field name="field_name" optional="show"/>
                    <field name="old_value" optional="show"/>
                    <field name="new_value" optional="show"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================
             AUDIT LOG — Form View (read-only)
             ============================================================ -->
        <record id="view_dayflow_audit_log_form" model="ir.ui.view">
            <field name="name">dayflow.audit.log.form</field>
            <field name="model">dayflow.audit.log</field>
            <field name="arch" type="xml">
                <form string="Audit Log Entry" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group string="Who &amp; When">
                                <field name="user_id" readonly="1"/>
                                <field name="timestamp" readonly="1"/>
                            </group>
                            <group string="What">
                                <field name="action" readonly="1"/>
                                <field name="model_name" readonly="1"/>
                                <field name="record_id" readonly="1"/>
                                <field name="record_name" readonly="1"/>
                            </group>
                        </group>
                        <group string="Change Details">
                            <field name="field_name" readonly="1"/>
                            <field name="old_value" readonly="1"/>
                            <field name="new_value" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             AUDIT LOG — Search View
             ============================================================ -->
        <record id="view_dayflow_audit_log_search" model="ir.ui.view">
            <field name="name">dayflow.audit.log.search</field>
            <field name="model">dayflow.audit.log</field>
            <field name="arch" type="xml">
                <search string="Search Audit Log">
                    <field name="user_id"/>
                    <field name="model_name"/>
                    <field name="action"/>
                    <filter string="Salary Updates" name="filter_salary"
                            domain="[('action', '=', 'salary_update')]"/>
                    <filter string="Leave Actions" name="filter_leave"
                            domain="[('action', 'in', ['leave_approved', 'leave_rejected'])]"/>
                    <group expand="0" string="Group By">
                        <filter string="User" name="group_user"
                                context="{'group_by': 'user_id'}"/>
                        <filter string="Action" name="group_action"
                                context="{'group_by': 'action'}"/>
                        <filter string="Model" name="group_model"
                                context="{'group_by': 'model_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================
             AUDIT LOG — Action (HR/Admin only)
             ============================================================ -->
        <record id="action_dayflow_audit_log" model="ir.actions.act_window">
            <field name="name">Audit Log</field>
            <field name="res_model">dayflow.audit.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dayflow_audit_log_search"/>
            <field name="groups_id" eval="[(6, 0, [ref('dayflow.group_dayflow_hr_admin')])]"/>
        </record>

    </data>
</odoo>
