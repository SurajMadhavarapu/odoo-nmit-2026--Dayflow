<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             PAYROLL — Form View
             ============================================================ -->
        <record id="view_dayflow_payroll_form" model="ir.ui.view">
            <field name="name">dayflow.payroll.form</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <form string="Salary Structure">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="display_name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Employee &amp; Period">
                                <field name="employee_id"
                                       attrs="{'readonly': [('id', '!=', False)]}"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="employee_id" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="effective_date"/>
                                <field name="currency_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <group string="Earnings">
                            <group>
                                <field name="basic_salary"
                                       attrs="{'readonly': [('id', '!=', False)]}"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="basic_salary" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="house_rent_allowance"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="house_rent_allowance" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="transport_allowance"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="transport_allowance" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="other_allowances"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="other_allowances" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                            </group>
                            <group>
                                <field name="gross_salary" readonly="1"/>
                            </group>
                        </group>
                        <group string="Deductions">
                            <group>
                                <field name="tax_deduction"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="tax_deduction" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="provident_fund"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="provident_fund" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                                <field name="other_deductions"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                                <field name="other_deductions" readonly="1"
                                       groups="dayflow.group_dayflow_employee"/>
                            </group>
                            <group>
                                <field name="total_deductions" readonly="1"/>
                            </group>
                        </group>
                        <group string="Net Salary">
                            <field name="net_salary" readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Notes" groups="dayflow.group_dayflow_hr_admin">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — List View
             ============================================================ -->
        <record id="view_dayflow_payroll_list" model="ir.ui.view">
            <field name="name">dayflow.payroll.list</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <tree string="Payroll Records">
                    <field name="employee_id"/>
                    <field name="effective_date"/>
                    <field name="basic_salary"/>
                    <field name="gross_salary"/>
                    <field name="total_deductions"/>
                    <field name="net_salary"/>
                    <field name="currency_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — Search View
             ============================================================ -->
        <record id="view_dayflow_payroll_search" model="ir.ui.view">
            <field name="name">dayflow.payroll.search</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <search string="Search Payroll">
                    <field name="employee_id"/>
                    <field name="effective_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_employee"
                                context="{'group_by': 'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — Actions
             ============================================================ -->
        <record id="action_dayflow_payroll_all" model="ir.actions.act_window">
            <field name="name">Payroll Records</field>
            <field name="res_model">dayflow.payroll</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dayflow_payroll_search"/>
            <field name="groups_id" eval="[(6, 0, [ref('dayflow.group_dayflow_hr_admin')])]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No payroll records. Add one per employee.
                </p>
            </field>
        </record>

        <record id="action_dayflow_my_payroll" model="ir.actions.act_window">
            <field name="name">My Salary</field>
            <field name="res_model">dayflow.payroll</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No salary records found for your profile.
                </p>
            </field>
        </record>

    </data>
</odoo>
