<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Payroll Views
    Owner: Mani (HR Core)

    Field reference (dayflow.payroll):
        employee_id, pay_period, currency_id,
        basic_salary, house_rent_allowance, transport_allowance, other_allowances,
        provident_fund, tax_deduction, other_deductions,
        gross_salary, total_deductions, net_salary,
        state, notes
    state values: draft | confirmed | paid
-->
<odoo>
    <data>

        <!-- ============================================================
             PAYROLL — List View
        ============================================================ -->
        <record id="view_dayflow_payroll_tree" model="ir.ui.view">
            <field name="name">dayflow.payroll.tree</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <tree string="Payroll Records"
                      decoration-success="state == 'paid'"
                      decoration-warning="state == 'confirmed'"
                      decoration-muted="state == 'draft'">
                    <field name="employee_id"/>
                    <field name="pay_period"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="basic_salary"/>
                    <field name="gross_salary"/>
                    <field name="total_deductions"/>
                    <field name="net_salary" decoration-bf="1"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — Form View
             All salary fields are read-only to employees via model write().
             The form itself uses attrs to make fields editable only when
             draft AND the user is HR Admin (enforced at model level anyway).
        ============================================================ -->
        <record id="view_dayflow_payroll_form" model="ir.ui.view">
            <field name="name">dayflow.payroll.form</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <form string="Salary Structure">
                    <header>
                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"
                                groups="dayflow.group_dayflow_hr_admin"/>
                        <button name="action_mark_paid"
                                string="Mark as Paid"
                                type="object"
                                class="btn-success"
                                attrs="{'invisible': [('state', '!=', 'confirmed')]}"
                                groups="dayflow.group_dayflow_hr_admin"/>
                        <button name="action_reset_draft"
                                string="Reset to Draft"
                                type="object"
                                attrs="{'invisible': [('state', '=', 'draft')]}"
                                groups="dayflow.group_dayflow_hr_admin"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,paid"/>
                    </header>
                    <sheet>
                        <!-- Header: employee + period -->
                        <group>
                            <group string="Employee">
                                <field name="employee_id"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="pay_period"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="currency_id"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"
                                       groups="dayflow.group_dayflow_hr_admin"/>
                            </group>
                        </group>

                        <!-- Earnings -->
                        <group string="Earnings">
                            <group>
                                <field name="basic_salary"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="house_rent_allowance"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="transport_allowance"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="other_allowances"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="gross_salary" readonly="1"/>
                            </group>
                        </group>

                        <!-- Deductions -->
                        <group string="Deductions">
                            <group>
                                <field name="provident_fund"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="tax_deduction"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="other_deductions"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="total_deductions" readonly="1"/>
                            </group>
                        </group>

                        <!-- Net -->
                        <group string="Net Pay">
                            <field name="net_salary" readonly="1"/>
                        </group>

                        <!-- Internal HR notes: hidden from employee group entirely -->
                        <group string="Notes" groups="dayflow.group_dayflow_hr_admin">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal HR notes — not visible to employees..."/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — Search View
        ============================================================ -->
        <record id="view_dayflow_payroll_search" model="ir.ui.view">
            <field name="name">dayflow.payroll.search</field>
            <field name="model">dayflow.payroll</field>
            <field name="arch" type="xml">
                <search string="Search Payroll">
                    <field name="employee_id"/>
                    <field name="pay_period"/>
                    <field name="state"/>
                    <filter string="My Salary" name="filter_mine"
                            domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="Draft"     name="filter_draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="filter_confirmed"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Paid"      name="filter_paid"
                            domain="[('state', '=', 'paid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee"   name="group_employee"
                                context="{'group_by': 'employee_id'}"/>
                        <filter string="Pay Period" name="group_period"
                                context="{'group_by': 'pay_period'}"/>
                        <filter string="Status"     name="group_state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================
             PAYROLL — Window Actions
        ============================================================ -->
        <record id="action_dayflow_payroll" model="ir.actions.act_window">
            <field name="name">Payroll</field>
            <field name="res_model">dayflow.payroll</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_dayflow_payroll_search"/>
        </record>

        <record id="action_dayflow_my_payroll" model="ir.actions.act_window">
            <field name="name">My Salary</field>
            <field name="res_model">dayflow.payroll</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_dayflow_payroll_search"/>
            <field name="context">{'search_default_filter_mine': 1}</field>
        </record>

    </data>
</odoo>
