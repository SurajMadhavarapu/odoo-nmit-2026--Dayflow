<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             ROOT MENU
        ============================================================ -->
        <menuitem id="menu_dayflow_root"
                  name="Dayflow HRMS"
                  sequence="10"
                  web_icon="dayflow,static/description/icon.png"/>

        <!-- ============================================================
             EMPLOYEE MENU
        ============================================================ -->
        <menuitem id="menu_dayflow_employees"
                  name="Employees"
                  parent="menu_dayflow_root"
                  sequence="10"
                  groups="dayflow.group_dayflow_hr"/>

        <menuitem id="menu_dayflow_employee_list"
                  name="All Employees"
                  parent="menu_dayflow_employees"
                  action="hr.open_view_employee_list_my"
                  sequence="10"/>

        <!-- ============================================================
             ATTENDANCE MENU
        ============================================================ -->
        <menuitem id="menu_dayflow_attendance"
                  name="Attendance"
                  parent="menu_dayflow_root"
                  sequence="20"/>

        <menuitem id="menu_dayflow_attendance_all"
                  name="All Records"
                  parent="menu_dayflow_attendance"
                  action="action_dayflow_attendance"
