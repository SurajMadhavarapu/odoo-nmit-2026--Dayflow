        <menuitem id="menu_dayflow_payroll_my"
                  name="My Salary"
                  parent="menu_dayflow_payroll"
                  action="action_dayflow_my_payroll"
                  sequence="20"/>

        <!-- ============================================================
             AUDIT LOG MENU (HR only)
        ============================================================ -->
        <menuitem id="menu_dayflow_audit"
                  name="Audit Log"
                  parent="menu_dayflow_root"
                  action="action_dayflow_audit_log"
                  sequence="90"
                  groups="dayflow.group_dayflow_hr"/>

