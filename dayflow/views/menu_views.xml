        <menuitem id="menu_dayflow_attendance_my"
                  name="My Attendance"
                  parent="menu_dayflow_attendance"
                  action="action_dayflow_attendance"
                  sequence="20"
                  groups="dayflow.group_dayflow_employee"/>

        <!-- ============================================================
             LEAVE MENU
        ============================================================ -->
        <menuitem id="menu_dayflow_leave"
                  name="Leave"
                  parent="menu_dayflow_root"
                  sequence="30"/>

        <menuitem id="menu_dayflow_leave_all"
                  name="All Requests"
