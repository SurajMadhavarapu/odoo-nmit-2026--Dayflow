<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             DAYFLOW — Top-level Menu
             ============================================================ -->
        <menuitem id="menu_dayflow_root"
                  name="Dayflow HRMS"
                  sequence="10"
                  web_icon="dayflow,static/description/icon.png"/>

        <!-- ============================================================
             EMPLOYEE sub-menu
             ============================================================ -->
        <menuitem id="menu_dayflow_employees"
                  name="Employees"
                  parent="menu_dayflow_root"
                  sequence="10"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <menuitem id="menu_dayflow_employee_list"
                  name="All Employees"
                  parent="menu_dayflow_employees"
                  action="action_dayflow_employee"
                  sequence="10"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <!-- ============================================================
             ATTENDANCE sub-menu
             ============================================================ -->
        <menuitem id="menu_dayflow_attendance"
                  name="Attendance"
                  parent="menu_dayflow_root"
                  sequence="20"/>

        <menuitem id="menu_dayflow_my_attendance"
                  name="My Attendance"
                  parent="menu_dayflow_attendance"
                  action="action_dayflow_my_attendance"
                  sequence="10"
                  groups="dayflow.group_dayflow_employee"/>

        <menuitem id="menu_dayflow_all_attendance"
                  name="All Attendance Records"
                  parent="menu_dayflow_attendance"
                  action="action_dayflow_attendance"
                  sequence="20"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <!-- ============================================================
             LEAVE sub-menu
             ============================================================ -->
        <menuitem id="menu_dayflow_leave"
                  name="Leave"
                  parent="menu_dayflow_root"
                  sequence="30"/>

        <menuitem id="menu_dayflow_my_leave"
                  name="My Leave Requests"
                  parent="menu_dayflow_leave"
                  action="action_dayflow_my_leaves"
                  sequence="10"
                  groups="dayflow.group_dayflow_employee"/>

        <menuitem id="menu_dayflow_all_leave"
                  name="All Leave Requests"
                  parent="menu_dayflow_leave"
                  action="action_dayflow_leave_all"
                  sequence="20"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <menuitem id="menu_dayflow_leave_pending"
                  name="Pending Approvals"
                  parent="menu_dayflow_leave"
                  action="action_dayflow_leave_pending"
                  sequence="30"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <!-- ============================================================
             PAYROLL sub-menu
             ============================================================ -->
        <menuitem id="menu_dayflow_payroll"
                  name="Payroll"
                  parent="menu_dayflow_root"
                  sequence="40"/>

        <menuitem id="menu_dayflow_my_salary"
                  name="My Salary"
                  parent="menu_dayflow_payroll"
                  action="action_dayflow_my_payroll"
                  sequence="10"
                  groups="dayflow.group_dayflow_employee"/>

        <menuitem id="menu_dayflow_all_payroll"
                  name="All Payroll Records"
                  parent="menu_dayflow_payroll"
                  action="action_dayflow_payroll_all"
                  sequence="20"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <!-- ============================================================
             ADMINISTRATION sub-menu (HR Admin only)
             ============================================================ -->
        <menuitem id="menu_dayflow_admin"
                  name="Administration"
                  parent="menu_dayflow_root"
                  sequence="90"
                  groups="dayflow.group_dayflow_hr_admin"/>

        <menuitem id="menu_dayflow_audit_log"
                  name="Audit Log"
                  parent="menu_dayflow_admin"
                  action="action_dayflow_audit_log"
                  sequence="10"
                  groups="dayflow.group_dayflow_hr_admin"/>

    </data>
</odoo>
