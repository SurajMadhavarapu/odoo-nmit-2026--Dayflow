<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             LEAVE REQUEST — Form View
             ============================================================ -->
        <record id="view_dayflow_leave_form" model="ir.ui.view">
            <field name="name">dayflow.leave.request.form</field>
            <field name="model">dayflow.leave.request</field>
            <field name="arch" type="xml">
                <form string="Leave Request">
                    <header>
                        <!-- HR/Admin buttons -->
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-success"
                                groups="dayflow.group_dayflow_hr_admin"
                                attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-danger"
                                groups="dayflow.group_dayflow_hr_admin"
                                attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                        <button name="action_reset_to_pending"
                                string="Reset to Pending"
                                type="object"
                                groups="dayflow.group_dayflow_hr_admin"
                                attrs="{'invisible': [('status', '!=', 'rejected')]}"/>
                        <field name="status" widget="statusbar"
                               statusbar_visible="pending,approved,rejected"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Request Details">
                                <field name="employee_id"
                                       attrs="{'readonly': [('status', '!=', 'pending')]}"/>
                                <field name="leave_type"
                                       attrs="{'readonly': [('status', '!=', 'pending')]}"/>
                            </group>
                            <group string="Dates">
                                <field name="date_from"
                                       attrs="{'readonly': [('status', '!=', 'pending')]}"/>
                                <field name="date_to"
                                       attrs="{'readonly': [('status', '!=', 'pending')]}"/>
                                <field name="number_of_days" readonly="1"/>
                            </group>
                        </group>
                        <group string="Remarks">
                            <field name="remarks" nolabel="1"
                                   placeholder="Reason for leave request..."
                                   attrs="{'readonly': [('status', '!=', 'pending')]}"/>
                        </group>
                        <group string="HR / Admin Decision"
                               attrs="{'invisible': [('status', '=', 'pending')]}">
                            <field name="approved_by" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                            <field name="hr_comment"
                                   placeholder="Add a comment (optional)..."
                                   groups="dayflow.group_dayflow_hr_admin"/>
                            <field name="hr_comment" readonly="1"
                                   groups="dayflow.group_dayflow_employee"
                                   attrs="{'invisible': [('hr_comment', '=', False)]}"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================
             LEAVE REQUEST — List View
             ============================================================ -->
        <record id="view_dayflow_leave_list" model="ir.ui.view">
            <field name="name">dayflow.leave.request.list</field>
            <field name="model">dayflow.leave.request</field>
            <field name="arch" type="xml">
                <tree string="Leave Requests"
                      decoration-success="status == 'approved'"
                      decoration-danger="status == 'rejected'"
                      decoration-warning="status == 'pending'">
                    <field name="employee_id"/>
                    <field name="leave_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="number_of_days"/>
                    <field name="status"/>
                    <field name="approved_by" optional="show"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================
             LEAVE REQUEST — Search View
             ============================================================ -->
        <record id="view_dayflow_leave_search" model="ir.ui.view">
            <field name="name">dayflow.leave.request.search</field>
            <field name="model">dayflow.leave.request</field>
            <field name="arch" type="xml">
                <search string="Search Leave Requests">
                    <field name="employee_id"/>
                    <field name="leave_type"/>
                    <field name="status"/>
                    <filter string="Pending" name="filter_pending"
                            domain="[('status', '=', 'pending')]"/>
                    <filter string="Approved" name="filter_approved"
                            domain="[('status', '=', 'approved')]"/>
                    <filter string="Rejected" name="filter_rejected"
                            domain="[('status', '=', 'rejected')]"/>
                    <separator/>
                    <filter string="Paid Leave" name="filter_paid"
                            domain="[('leave_type', '=', 'paid')]"/>
                    <filter string="Sick Leave" name="filter_sick"
                            domain="[('leave_type', '=', 'sick')]"/>
                    <filter string="Unpaid Leave" name="filter_unpaid"
                            domain="[('leave_type', '=', 'unpaid')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_employee"
                                context="{'group_by': 'employee_id'}"/>
                        <filter string="Status" name="group_status"
                                context="{'group_by': 'status'}"/>
                        <filter string="Leave Type" name="group_type"
                                context="{'group_by': 'leave_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================
             LEAVE REQUEST — Actions
             ============================================================ -->
        <record id="action_dayflow_leave_all" model="ir.actions.act_window">
            <field name="name">All Leave Requests</field>
            <field name="res_model">dayflow.leave.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dayflow_leave_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No leave requests found.
                </p>
            </field>
        </record>

        <record id="action_dayflow_leave_pending" model="ir.actions.act_window">
            <field name="name">Pending Approvals</field>
            <field name="res_model">dayflow.leave.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('status', '=', 'pending')]</field>
            <field name="search_view_id" ref="view_dayflow_leave_search"/>
        </record>

        <record id="action_dayflow_my_leaves" model="ir.actions.act_window">
            <field name="name">My Leave Requests</field>
            <field name="res_model">dayflow.leave.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="context">{'default_employee_id': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    You have no leave requests. Apply for leave using the button above.
                </p>
            </field>
        </record>

    </data>
</odoo>
