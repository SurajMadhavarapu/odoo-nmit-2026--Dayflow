<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Security Groups and Record Rules
    Owner: Mani (HR Core)

    CANONICAL GROUP XML IDs (do not rename without notifying Suraj + teammates):
      dayflow.group_dayflow_employee   — regular employees
      dayflow.group_dayflow_hr_admin   — HR officers and admins

    Record rule naming convention:
      Odoo auto-generates model external IDs as:
        model_<model_name_with_underscores>
      e.g.  dayflow.attendance  →  dayflow.model_dayflow_attendance
            dayflow.leave.request → dayflow.model_dayflow_leave_request
            dayflow.payroll       → dayflow.model_dayflow_payroll
            dayflow.audit.log     → dayflow.model_dayflow_audit_log
      For hr.employee (from hr module): hr.model_hr_employee
-->
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             MODULE CATEGORY
        ============================================================ -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">Dayflow Human Resource Management System</field>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================================
             SECURITY GROUPS
        ============================================================ -->

        <!-- Employee group — base access -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="comment">
                View own profile and attendance, apply for leave, view own salary.
            </field>
        </record>

        <!-- HR Admin group — inherits all employee permissions -->
        <record id="group_dayflow_hr_admin" model="res.groups">
            <field name="name">HR / Admin</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="comment">
                Manage employees, approve/reject leave, update payroll, view all records.
            </field>
        </record>

        <!-- ============================================================
             RECORD RULES — row-level security
             Employee rules: filter to own records.
             HR Admin rules: domain 1=1 (see everything).
             HR Admin inherits employee group, so both rules apply;
             the broader HR Admin rule takes precedence.
        ============================================================ -->

        <!-- ──────────────── hr.employee ──────────────── -->
        <record id="rule_employee_own_profile_read" model="ir.rule">
            <field name="name">Dayflow Employee: read own profile</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_employee_hr_admin_all" model="ir.rule">
            <field name="name">Dayflow HR Admin: all employee profiles</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ──────────────── dayflow.attendance ──────────────── -->
        <record id="rule_attendance_employee_own" model="ir.rule">
            <field name="name">Dayflow Attendance: employee sees own</field>
            <field name="model_id" ref="dayflow.model_dayflow_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_attendance_hr_admin_all" model="ir.rule">
            <field name="name">Dayflow Attendance: HR Admin sees all</field>
            <field name="model_id" ref="dayflow.model_dayflow_attendance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ──────────────── dayflow.leave.request ──────────────── -->
        <record id="rule_leave_employee_own" model="ir.rule">
            <field name="name">Dayflow Leave: employee sees own requests</field>
            <field name="model_id" ref="dayflow.model_dayflow_leave_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_leave_hr_admin_all" model="ir.rule">
            <field name="name">Dayflow Leave: HR Admin sees all requests</field>
            <field name="model_id" ref="dayflow.model_dayflow_leave_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ──────────────── dayflow.payroll ──────────────── -->
        <!-- Employee: read-only on own record; no write/create/delete -->
        <record id="rule_payroll_employee_own_readonly" model="ir.rule">
            <field name="name">Dayflow Payroll: employee reads own</field>
            <field name="model_id" ref="dayflow.model_dayflow_payroll"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_payroll_hr_admin_all" model="ir.rule">
            <field name="name">Dayflow Payroll: HR Admin manages all</field>
            <field name="model_id" ref="dayflow.model_dayflow_payroll"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ──────────────── dayflow.audit.log ──────────────── -->
        <!-- Employees: no access at all (not listed in ACL CSV either) -->
        <record id="rule_audit_log_hr_admin_readonly" model="ir.rule">
            <field name="name">Dayflow Audit Log: HR Admin read-only</field>
            <field name="model_id" ref="dayflow.model_dayflow_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
