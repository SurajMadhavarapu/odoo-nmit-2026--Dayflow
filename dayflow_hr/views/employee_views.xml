<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Employee Views — Odoo 17 compatible
    Owner: Mani (HR Core)
    Extends hr.employee form / list / search.
    Harshith: use df_attendance_count / df_leave_count stat buttons for dashboard.
-->
<odoo>

    <!-- ── Extend hr.employee form: add Dayflow tab + stat buttons ── -->
    <record id="view_employee_form_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.form.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Stat buttons (HR Admin only) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_open_attendance"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        groups="dayflow_hr.group_dayflow_hr_admin">
                    <field name="df_attendance_count" widget="statinfo" string="Attendance"/>
                </button>
                <button type="object"
                        name="action_open_leaves"
                        class="oe_stat_button"
                        icon="fa-plane"
                        groups="dayflow_hr.group_dayflow_hr_admin">
                    <field name="df_leave_count" widget="statinfo" string="Leaves"/>
                </button>
            </xpath>

            <!-- Employee ID field, HR Admin editable, read-only after first save -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_code"
                       readonly="id"
                       groups="dayflow_hr.group_dayflow_hr_admin"/>
            </xpath>

            <!-- Dayflow tab inside notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Dayflow HR" name="dayflow_hr_tab">
                    <group string="Employment"
                           groups="dayflow_hr.group_dayflow_hr_admin">
                        <field name="df_employment_type"/>
                        <field name="df_joining_date"/>
                        <field name="df_role"/>
                        <field name="df_active"/>
                    </group>
                    <group string="Personal (Self-Service)">
                        <field name="df_phone"/>
                        <field name="df_address"/>
                        <field name="df_emergency_contact"/>
                        <field name="df_emergency_phone"/>
                    </group>
                    <group string="Confidential"
                           groups="dayflow_hr.group_dayflow_hr_admin">
                        <field name="df_date_of_birth"/>
                        <field name="df_gender"/>
                    </group>
                    <group string="Payroll Summary">
                        <field name="df_payroll_ids" readonly="1" nolabel="1">
                            <tree string="Payroll Records">
                                <field name="pay_period"/>
                                <field name="gross_salary"/>
                                <field name="net_salary"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ── hr.employee list: add employee_code column (HR Admin only) ── -->
    <record id="view_employee_tree_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.tree.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_code"
                       optional="show"
                       groups="dayflow_hr.group_dayflow_hr_admin"/>
            </xpath>
        </field>
    </record>

    <!-- ── hr.employee search: add employee_code ── -->
    <record id="view_employee_filter_dayflow" model="ir.ui.view">
        <field name="name">hr.employee.search.dayflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_code"/>
            </xpath>
        </field>
    </record>

</odoo>
