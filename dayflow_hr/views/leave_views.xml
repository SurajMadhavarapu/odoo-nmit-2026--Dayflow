<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow Leave Request Views
    Owner: Mani (model/backend) | Kunam extends this for workflow UI
    Provides minimal list + form + search + actions.
-->
<odoo>

    <!-- ── List view ── -->
    <record id="view_dayflow_leave_tree" model="ir.ui.view">
        <field name="name">dayflow.leave.request.tree</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <tree string="Leave Requests"
                  decoration-warning="state=='pending'"
                  decoration-success="state=='approved'"
                  decoration-danger="state=='rejected'"
                  decoration-muted="state=='draft'">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days"/>
                <field name="state"/>
                <field name="approved_by" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ── Form view ── -->
    <record id="view_dayflow_leave_form" model="ir.ui.view">
        <field name="name">dayflow.leave.request.form</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            groups="dayflow_hr.group_dayflow_hr_admin"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            groups="dayflow_hr.group_dayflow_hr_admin"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            groups="dayflow_hr.group_dayflow_hr_admin"
                            attrs="{'invisible': [('state', 'not in', ['rejected', 'pending'])]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <group string="Leave Details">
                        <field name="employee_id"
                               attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="leave_type"
                               attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="date_from"
                               attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="date_to"
                               attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="number_of_days" readonly="1"/>
                        <field name="remarks"
                               attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </group>
                    <group string="HR Decision" groups="dayflow_hr.group_dayflow_hr_admin">
                        <field name="hr_comment"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Search view ── -->
    <record id="view_dayflow_leave_search" model="ir.ui.view">
        <field name="name">dayflow.leave.request.search</field>
        <field name="model">dayflow.leave.request</field>
        <field name="arch" type="xml">
            <search string="Search Leave Requests">
                <field name="employee_id"/>
                <field name="leave_type"/>
                <filter string="My Leaves"  name="my_leaves"
                        domain="[('employee_id.user_id','=',uid)]"/>
                <filter string="Pending"    name="pending"
                        domain="[('state','=','pending')]"/>
                <filter string="Approved"   name="approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Rejected"   name="rejected"
                        domain="[('state','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee"   name="grp_employee"  context="{'group_by': 'employee_id'}"/>
                    <filter string="Status"     name="grp_state"     context="{'group_by': 'state'}"/>
                    <filter string="Leave Type" name="grp_type"      context="{'group_by': 'leave_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window action ── -->
    <record id="action_dayflow_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">dayflow.leave.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_dayflow_leave_search"/>
        <field name="context">{'search_default_my_leaves': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leave requests yet. Click New to apply for leave.
            </p>
        </field>
    </record>

</odoo>
