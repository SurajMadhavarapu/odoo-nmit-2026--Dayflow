<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Dayflow Module Category -->
        <record id="module_category_dayflow_hr" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">User access levels for Dayflow HRMS</field>
            <field name="sequence">10</field>
        </record>

        <!-- Dayflow Employee Group -->
        <record id="group_dayflow_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow_hr"/>
            <field name="comment">Basic employee access to Dayflow HRMS (own profile, attendance, leave, payslips).</field>
        </record>

        <!-- Dayflow HR / Admin Group -->
        <record id="group_dayflow_hr_admin" model="res.groups">
            <field name="name">HR / Admin</field>
            <field name="category_id" ref="module_category_dayflow_hr"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="comment">Full administrative access to Dayflow HRMS management functions.</field>
        </record>

        <!-- Record Rule: Employee can only view/edit own profile -->
        <record id="hr_employee_rule_dayflow_employee" model="ir.rule">
            <field name="name">Dayflow Employee: Access Own Profile Only</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: HR/Admin can manage all profiles -->
        <record id="hr_employee_rule_dayflow_hr_admin" model="ir.rule">
            <field name="name">Dayflow HR/Admin: Access All Profiles</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_dayflow_hr_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
